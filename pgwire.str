# PostgreSQL v3 Wire Protocol Server (TCP)
import engine
import sql
import threading
from typing import Callable

@extern("pthread_create")
def _pg_pthread_create(tid: addr[u64], attr: addr[u8] | None, start_routine: Callable[[addr[u8]], addr[u8] | None], arg: addr[u8] | None) -> i32:
    pass

@extern("pthread_detach")
def _pg_pthread_detach(tid: u64) -> i32:
    pass

_db_dir: str = ""
_db_names: list[str] = []
_db_list: list[engine.Database] = []
_rw_list: list[threading.RWLock] = []
_db_map_lock: threading.RWLock | None = None

def _rdlock_db(idx: int) -> None:
    if idx >= 0 and idx < len(_rw_list):
        _rw_list[idx].acquire_read()

def _wrlock_db(idx: int) -> None:
    if idx >= 0 and idx < len(_rw_list):
        _rw_list[idx].acquire_write()

def _unlock_db(idx: int) -> None:
    if idx >= 0 and idx < len(_rw_list):
        _rw_list[idx].release()

def _sanitize_dbname(name: str) -> str:
    out = ""
    i = 0
    n = len(name)
    while i < n:
        ch = name[i]
        if (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or (ch >= "0" and ch <= "9") or ch == "_" or ch == "-":
            out += ch
        i += 1
    if len(out) == 0:
        return "postgres"
    return out

def _parse_startup_db(buf: addr[u8], n: int) -> str:
    i = 0
    while i < n:
        if int(val(buf + i)) == 0:
            break
        kstart = i
        while i < n and int(val(buf + i)) != 0:
            i += 1
        key = unbin(buf + kstart)
        i += 1
        if i >= n:
            break
        vstart = i
        while i < n and int(val(buf + i)) != 0:
            i += 1
        v = unbin(buf + vstart)
        i += 1
        if key == "database":
            return v
    return "postgres"

def _resolve_db_idx(dbname: str) -> int:
    if len(_db_dir) == 0:
        return 0
    clean = _sanitize_dbname(dbname)
    if _db_map_lock is not None:
        _db_map_lock.acquire_read()
    i = 0
    while i < len(_db_names):
        if _db_names[i] == clean:
            if _db_map_lock is not None:
                _db_map_lock.release()
            return i
        i += 1
    if _db_map_lock is not None:
        _db_map_lock.release()
        _db_map_lock.acquire_write()
    i = 0
    while i < len(_db_names):
        if _db_names[i] == clean:
            if _db_map_lock is not None:
                _db_map_lock.release()
            return i
        i += 1
    path = _db_dir + "/" + clean + ".strictql"
    db = engine.open_db(path)
    db.store.server_mode = True
    idx = len(_db_list)
    _db_names.append(clean)
    _db_list.append(db)
    _rw_list.append(threading.RWLock())
    if _db_map_lock is not None:
        _db_map_lock.release()
    return idx

def _is_read_only_query(q: str) -> bool:
    n = len(q)
    i = 0
    while i < n and (q[i] == " " or q[i] == "\t" or q[i] == "\n" or q[i] == "\r"):
        i += 1
    if i + 6 > n:
        return False
    p = q[i:i + 6].upper()
    if p != "SELECT":
        return False
    if i + 6 < n:
        ch = q[i + 6]
        if ch != " " and ch != "\t" and ch != "\n" and ch != "\r" and ch != "(":
            return False
    return True
